# ---- Secrets (CRITICAL: never commit) ----
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# ---- Run artifacts ----
runs/*
# ...except the P5 benchmark report, which is a deliverable, not a scratch run.
!runs/benchmark/
runs/benchmark/*
!runs/benchmark/results.json
!runs/benchmark/results.md
!runs/benchmark/failure-analysis.md
!runs/benchmark/RESULTS_SUMMARY.md
*.patch
state.db
*.sqlite
*.sqlite3

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# ---- Testing / tooling caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
report.json

# ---- Knowledge graph (commit the graph, not its extraction cache) ----
graphify-out/cache/

# ---- Editor / OS ----
.vscode/
.idea/
*.swp
.DS_Store

# ---- Corpus scratch (keep committed corpora; ignore working copies) ----
corpus/**/repo_rw/
corpus/**/*.tmp
