# .env.example  —  copy to .env and fill in real values. NEVER commit .env.
# .env is gitignored. Real secrets live only in your local .env, never here.

# ---- LLM provider (DeepSeek, OpenAI-compatible) ----
# Get a key at https://platform.deepseek.com (5M free tokens on signup).
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model IDs (see docs/RESOURCE_PACK.md). Pro for edits/trace reasoning, Flash for summaries.
MRA_EDIT_MODEL=deepseek-v4-pro
MRA_UTILITY_MODEL=deepseek-v4-flash

# ---- Agent constraints (mirror docs/03_SRS.md §6 NFRs) ----
MRA_MAX_FIX_ATTEMPTS=3
MRA_TOKEN_BUDGET=2000000
MRA_RUN_TIMEOUT_SEC=1800
MRA_PYTEST_TIMEOUT_SEC=120
MRA_EDIT_BATCH_SIZE=3
MRA_LLM_TEMPERATURE=0.1

# ---- Sandbox ----
MRA_SANDBOX_IMAGE=mra-sandbox:py312
MRA_CONTAINER_RUNTIME=docker            # docker | podman

# ---- Optional: extra providers if you later route to Groq/OpenRouter ----
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
